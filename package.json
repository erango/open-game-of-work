{
  "name": "open-game-of-work",
  "version": "0.1.0",
  "private": true,
  "description": "A clean-room reimplementation of Game of Work (Hotpot Software, 2000)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.test.ts",
    "check:contrast": "node test/contrast.mjs",
    "art:manifest": "node scripts/art-manifest.mjs",
    "art:gen": "node scripts/art-manifest.mjs && node scripts/perchance-gen.mjs",
    "art:cutout": "node scripts/art-manifest.mjs && bash scripts/run-cutout.sh",
    "check:shippable": "node scripts/check-shippable.mjs",
    "audio:encode": "bash scripts/audio-encode.sh",
    "sfx:manifest": "node scripts/sfx-manifest.mjs",
    "sfx:gen": "node scripts/sfx-gen.mjs",
    "sfx:post": "bash scripts/sfx-post.sh",
    "art:dice": "bash -c '\"${PY:-.cache/venv/bin/python}\" scripts/die-faces.py'"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "playwright": "^1.50.0"
  }
}
