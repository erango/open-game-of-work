{
  "name": "open-game-of-work",
  "version": "0.1.0",
  "private": true,
  "description": "A clean-room reimplementation of Game of Work (Hotpot Software, 2000)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.test.ts",
    "art:manifest": "node scripts/art-manifest.mjs",
    "art:gen": "node scripts/art-manifest.mjs && node scripts/perchance-gen.mjs",
    "art:cutout": "node scripts/art-manifest.mjs && bash scripts/run-cutout.sh"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "playwright": "^1.50.0"
  }
}
